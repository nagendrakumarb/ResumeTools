<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ProfessionalHub.ResumeTools</AssemblyName>
    <RootNamespace>ProfessionalHub.ResumeTools</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorEnableCompression>true</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.17" PrivateAssets="all" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProfessionalHub.ResumeTools.Core\ProfessionalHub.ResumeTools.Core.csproj" />
  </ItemGroup>

  <Target Name="GenerateLocalJobCatalog"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildProjectDirectory)\job-providers.json') and '$(SkipJobCatalogBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          Command="dotnet run --project tools\JobCatalogBuilder\JobCatalogBuilder.csproj -c $(Configuration) --no-launch-profile" />
  </Target>

</Project>
