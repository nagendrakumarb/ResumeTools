@inject IJSRuntime JSRuntime

<div class="my-3 text-center page-shell">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="@PublisherId"
         data-ad-slot="@AdSlot"
         data-ad-format="@AdFormat"
         data-full-width-responsive="@FullWidthResponsive.ToString().ToLower()"></ins>
</div>

@code {
    [Parameter] public string PublisherId { get; set; } = "ca-pub-8487728962349258";
    [Parameter] public string AdSlot { get; set; } = "8171493818"; // Live Top Banner Ad Slot
    [Parameter] public string AdFormat { get; set; } = "auto";
    [Parameter] public bool FullWidthResponsive { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Gives Blazor time to commit the <ins> tag to the browser DOM before JS execution
            await Task.Yield();

            try
            {
                await JSRuntime.InvokeVoidAsync("professionalHub.adsense.push");
            }
            catch (JSDisconnectedException)
            {
                // Safely handles circuit drops during SPA navigation
            }
            catch (Exception ex)
            {
                Console.WriteLine($"AdSense push error: {ex.Message}");
            }
        }
    }
}