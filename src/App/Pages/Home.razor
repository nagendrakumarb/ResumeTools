    private async Task ReadTemplateAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File; var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".docx" or ".pdf" or ".png" or ".jpg" or ".jpeg" or ".webp")) throw new NotSupportedException("Template must be DOCX, PDF, PNG, JPG, or WebP.");
            await using var input = file.OpenReadStream(MaxFileSize); await using var buffer = new MemoryStream(); await input.CopyToAsync(buffer);
            var bytes = buffer.ToArray(); uploadedTemplate = new UploadedResumeTemplate(file.Name, extension[1..].ToUpperInvariant(), bytes); imageTemplateAnalysis = null;
            if (extension is ".png" or ".jpg" or ".jpeg" or ".webp")
            {
                imageTemplateAnalysis = await JS.InvokeAsync<ImageTemplateAnalysis>("professionalHub.images.analyzeTemplate", Convert.ToBase64String(bytes), file.ContentType);
                uploadedTemplateStatus = $"Ready: {file.Name} / {imageTemplateAnalysis.Layout} / accent #{imageTemplateAnalysis.AccentHex}";
            }
            else uploadedTemplateStatus = $"Ready: {file.Name}";
        }
        catch (Exception ex) { uploadedTemplate = null; uploadedTemplateStatus = ex.Message; }
    }

