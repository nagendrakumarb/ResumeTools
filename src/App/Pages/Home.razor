    private async Task SearchJobsAsync()
    {
        if (selectedSources.Count == 0)
        {
            error = "Select at least one job source before searching.";
            return;
        }
        isBusy = true; error = null; jobResults = []; liveSearchStatus = "";
        busyTitle = "Searching job providers";
        busyDetail = "Fetching structured listings and normalizing titles, companies, locations, dates, and descriptions...";
        await InvokeAsync(StateHasChanged); await Task.Yield();
        try
        {
            var requestedKeywords = selectedKeywords.ToList();
            if (!string.IsNullOrWhiteSpace(customKeyword) &&
                !requestedKeywords.Contains(customKeyword.Trim(), StringComparer.OrdinalIgnoreCase))
                requestedKeywords.Add(customKeyword.Trim());
            var requestedLocations = selectedLocations.ToList();
            if (!string.IsNullOrWhiteSpace(customLocation) &&
                !requestedLocations.Contains(customLocation.Trim(), StringComparer.OrdinalIgnoreCase))
                requestedLocations.Add(customLocation.Trim());

            var searchRequest = new JobSearchRequest(
                JobApiProvider.Catalog,
                requestedKeywords.Count == 0 ? "" : string.Join("|||", requestedKeywords),
                requestedLocations.Count == 0 ? "" : string.Join("|||", requestedLocations),
                jobExperience, jobAgeDays, "", "",
                selectedSources.Count == 0 ? "All" : string.Join(',', selectedSources));
            var fetchedJobs = selectedSources.Count > 0
                ? await JobSearch.SearchConfiguredProvidersAsync(localProviderConfiguration, searchRequest, selectedSources)
                : await JobSearch.SearchAsync(searchRequest);
            liveSearchStatus = JobSearch.LastSearchSourceMessage;
            if (jobFolderReady)
                appliedJobFingerprints = new(await JobApplications.LoadFingerprintsAsync(), StringComparer.OrdinalIgnoreCase);
            var hiddenCount = fetchedJobs.Count(job =>
                appliedJobFingerprints.Contains(JobApplicationStore.Fingerprint(job)));
            jobResults = fetchedJobs
                .Where(job => !appliedJobFingerprints.Contains(JobApplicationStore.Fingerprint(job)))
                .ToList();
            selectedJobFingerprints.Clear();
            if (hiddenCount > 0)
                jobFolderMessage = $"{hiddenCount} previously applied/completed job{(hiddenCount == 1 ? " was" : "s were")} removed from these results.";
            if (jobResults.Count == 0)
            {
                var unavailable = catalogProviderStates
                    .Where(x => selectedSources.Contains(x.Name) &&
                                x.Status is "exhausted" or "failed" or "not-configured" or "disabled" or "balance-check-failed")
                    .Select(x => $"{x.Name}: {SourceStatus(x)}").ToList();
                error = unavailable.Count > 0
                    ? $"No jobs are available from the selected sources. {string.Join(" ", unavailable)}"
                    : "No jobs matched these filters. Try a broader role, remove the experience level, increase the date range, or return to automatic sources.";
            }
        }
        catch (HttpRequestException ex)
        {
            error = $"Could not search the job catalog: {ex.Message}";
        }
        catch (Exception ex) { error = $"Could not search the job catalog: {ex.Message}"; }
        finally { isBusy = false; }
    }

    private async Task LoadLocalProviderConfigurationAsync(InputFileChangeEventArgs args)
    {
        error = null;
        try
        {
            var file = args.File;
            if (!file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
                throw new InvalidDataException("Choose a JSON provider configuration file.");
            await using var stream = file.OpenReadStream(1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            using var document = JsonDocument.Parse(json, new JsonDocumentOptions
            {
                CommentHandling = JsonCommentHandling.Skip,
                AllowTrailingCommas = true
            });
            if (!document.RootElement.TryGetProperty("providers", out var providers) ||
                providers.ValueKind != JsonValueKind.Array)
                throw new InvalidDataException("The file does not contain a providers array.");
            localProviderConfiguration = json;
            localProviderStatus = $"{file.Name} loaded for this browser tab. Keys remain in memory and are not uploaded.";
        }
        catch (Exception ex)
        {
            localProviderConfiguration = null;
            localProviderStatus = "No live provider configuration loaded.";
            error = $"Could not load the local provider configuration: {ex.Message}";
        }
    }

