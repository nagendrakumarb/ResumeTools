    private static bool Accept(HashSet<string> selected, string value) =>
        selected.Count == 0 || selected.Contains(value);
    private static string EmptyAs(string value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    private static string JobText(NormalizedJob job) => $"{job.Title} {job.Description}".ToLowerInvariant();
    private static string WorkMode(NormalizedJob job)
    {
        var text = $"{job.Location} {job.Title} {job.Description}".ToLowerInvariant();
        if (text.Contains("hybrid")) return "Hybrid";
        if (text.Contains("remote") || text.Contains("work from home") || text.Contains("worldwide")) return "Remote";
        return "On-site / unspecified";
    }
    private static string ExperienceBand(NormalizedJob job)
    {
        var text = JobText(job);
        if (text.Contains("intern") || text.Contains("entry level") || text.Contains("graduate")) return "Entry level";
        if (text.Contains("principal") || text.Contains("staff ") || text.Contains("director") || text.Contains("head of")) return "Staff / leadership";
        if (text.Contains("senior") || text.Contains("lead ")) return "Senior";
        if (System.Text.RegularExpressions.Regex.IsMatch(text, @"\b[3-9]\+?\s*(years?|yrs?)\b")) return "Experienced";
        return "Not specified";
    }
    private static string RoleCategory(NormalizedJob job)
    {
        var text = JobText(job);
        if (text.Contains("devops") || text.Contains("cloud") || text.Contains("site reliability")) return "Cloud / DevOps";
        if (text.Contains("data ") || text.Contains("machine learning") || text.Contains(" ai ")) return "Data / AI";
        if (text.Contains("quality") || text.Contains(" qa ") || text.Contains("test automation")) return "Quality assurance";
        if (text.Contains("product manager") || text.Contains("product owner")) return "Product";
        if (text.Contains("sales") || text.Contains("marketing")) return "Sales / Marketing";
        if (text.Contains("support") || text.Contains("customer success")) return "Customer support";
        if (text.Contains("developer") || text.Contains("engineer") || text.Contains("architect")) return "Software engineering";
        return "Other";
    }
    private static string SalarySignal(NormalizedJob job) =>
        System.Text.RegularExpressions.Regex.IsMatch(JobText(job), @"([$€£₹]\s?\d|salary|compensation)") ? "Salary mentioned" : "Not disclosed";
    private static string EducationSignal(NormalizedJob job)
    {
        var text = JobText(job);
        if (text.Contains("phd") || text.Contains("doctorate")) return "Doctorate mentioned";
        if (text.Contains("master") || text.Contains("mba")) return "Postgraduate mentioned";
        if (text.Contains("bachelor") || text.Contains("degree")) return "Degree mentioned";
        return "Not specified";
    }
    private static string Freshness(NormalizedJob job)
    {
        if (!DateTimeOffset.TryParse(job.PostedAt, out var posted)) return "Date unavailable";
        var age = (DateTimeOffset.UtcNow - posted).TotalDays;
        return age <= 1 ? "Last 24 hours" : age <= 7 ? "Last 7 days" : age <= 30 ? "Last 30 days" : "Older";
    }
