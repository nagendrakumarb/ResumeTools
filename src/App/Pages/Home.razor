@page "/"
@using System.Text.Json
@inject ResumeParserService Parser
@inject SimilarityService Similarity
@inject AtsCompatibilityService Ats
@inject JobDescriptionService JobReader
@inject JobSearchService JobSearch
@inject JobApplicationStore JobApplications
@inject AnalysisHistoryService History
@inject ResumeImprovementService Improver
@inject IJSRuntime JS
@inject ResumeCorrectionService CorrectionService
@inject IConfiguration Configuration
<PageTitle>ATS Resume Checker & Job Match | Professional Hub</PageTitle>

@if (isBusy)
{
    <div class="processing-mask" role="dialog" aria-modal="true" aria-live="assertive" aria-label="Processing resume">
        <div class="processing-card">
            <div class="processing-animation" aria-hidden="true"><i></i><i></i><i></i></div>
            <h2>@busyTitle</h2><p>@busyDetail</p>
            <div class="processing-track"><span></span></div>
            <small>Please keep this page open. Your resume remains on this device.</small>
        </div>
    </div>
}

<section class="hero"><span class="eyebrow">Private • Offline resume analysis</span><h1>Make your resume ATS-ready.</h1><p>Check ATS compatibility first, then compare your resume with any job posting.</p></section>

<div class="tool-tabs" role="tablist" aria-label="Resume tools">
    <button class="@(mode == ToolMode.Ats ? "active" : null)" @onclick="() => SetMode(ToolMode.Ats)">ATS compatibility</button>
    <button class="@(mode == ToolMode.JobMatch ? "active" : null)" @onclick="() => SetMode(ToolMode.JobMatch)">Job match</button>
</div>

<main class="workspace">
    <section class="panel">
        <label class="field-label" for="resume">1. Choose your resume</label>
        <InputFile id="resume" OnChange="ReadResumeAsync" accept=".pdf,.docx" class="form-control" />
        <div class="file-status">@fileStatus</div>

        @if (mode == ToolMode.Ats)
        {
            <div class="feature-copy"><h2>ATS compatibility scan</h2><p>Checks contact details, standard sections, measurable achievements, resume length, and text readability. No job description is required.</p></div>
            <button class="score-button" @onclick="AnalyzeAtsAsync" disabled="@(!HasResume || isBusy)">Check ATS compatibility</button>
            @if (!HasResume && string.IsNullOrWhiteSpace(error))
            {
                <p class="action-hint">Choose a PDF or DOCX resume to begin.</p>
            }
        }
        else
        {
            <details class="job-api-search">
                <summary>Search maintained job APIs</summary>
                <p>Search the automatically managed catalog. Free public feeds are used first, then configured providers are rotated according to their available quota.</p>
                <div class="job-search-grid">
                    <div class="multi-filter">
                        <span class="filter-label">Job titles and keywords</span>
                        <div class="custom-option-row">
                            <input @bind="customKeyword" @bind:event="oninput" list="keyword-options" placeholder="Type or select a job title" />
                            <button type="button" @onclick="AddCustomKeyword" disabled="@string.IsNullOrWhiteSpace(customKeyword)">Add</button>
                        </div>
                        <datalist id="keyword-options">
                            @foreach (var keyword in catalogKeywords)
                            {
                                <option value="@keyword"></option>
                            }
                        </datalist>
                        <details class="filter-checklist">
                            <summary>@SelectionSummary(selectedKeywords, "All configured job titles")</summary>
                            <div class="role-groups">
                                @foreach (var group in catalogRoleGroups)
                                {
                                    var filteredRoles = group.Roles.Where(FilterKeyword).ToList();
                                    if (filteredRoles.Count > 0)
                                    {
                                        <section class="role-option-group">
                                            <strong>@group.Name</strong>
                                            @foreach (var keyword in filteredRoles)
                                            {
                                                <label><input type="checkbox" checked="@selectedKeywords.Contains(keyword)" @onchange="args => ToggleValue(selectedKeywords, keyword, args)" />@keyword</label>
                                            }
                                        </section>
                                    }
                                }
                            </div>
                        </details>
                    </div>
                    <div class="multi-filter">
                        <span class="filter-label">Locations</span>
                        <div class="custom-option-row">
                            <input @bind="customLocation" @bind:event="oninput" list="location-options" placeholder="Type or select a location" />
                            <button type="button" @onclick="AddCustomLocation" disabled="@string.IsNullOrWhiteSpace(customLocation)">Add</button>
                        </div>
                        <datalist id="location-options">
                            @foreach (var location in catalogLocations)
                            {
                                <option value="@location"></option>
                            }
                        </datalist>
                        <details class="filter-checklist">
                            <summary>@SelectionSummary(selectedLocations, "All configured locations")</summary>
                            <div>
                                @foreach (var location in catalogLocations.Where(FilterLocation))
                                {
                                    <label><input type="checkbox" checked="@selectedLocations.Contains(location)" @onchange="args => ToggleValue(selectedLocations, location, args)" />@location</label>
                                }
                            </div>
                        </details>
                    </div>
                    <label>Experience level<input @bind="jobExperience" @bind:event="oninput" placeholder="senior" /></label>
                    <label>Posted within days<input type="number" min="1" max="365" @bind="jobAgeDays" /></label>
                </div>
                @if (catalogProviderStates.Count > 0)
                {
                    <details class="source-override" open>
                        <summary>Job sources <span>(@selectedSources.Count selected)</span></summary>
                        <p>Select at least one source. Multiple selected sources are searched together; no source is chosen randomly when the list is empty.</p>
                        <div class="source-options">
                            @foreach (var source in catalogProviderStates)
                            {
                                <label class="source-option @SourceStatusClass(source.Status)">
                                    <input type="checkbox"
                                           checked="@selectedSources.Contains(source.Name)"
                                           @onchange="args => ToggleSource(source.Name, args)" />
                                    <span><strong>@source.Name</strong><small>@SourceStatus(source)</small></span>
                                </label>
                            }
                        </div>
                    </details>
                }
                <div class="local-provider-config">
                    <strong>Private API configuration</strong>
                    <p>Built-in public sources work without this file. Download the template, add your provider credentials locally, then upload it for this browser tab.</p>
                    <div class="provider-config-actions">
                        <a class="provider-template-button" href="templates/job-providers.template.json" download="job-providers.json">Download JSON template</a>
                        <label class="provider-upload-button">
                            <span>Upload provider JSON</span>
                            <InputFile OnChange="LoadLocalProviderConfigurationAsync" accept=".json,application/json" />
                        </label>
                    </div>
                    <small>@localProviderStatus</small>
                </div>
                <small class="catalog-status">@catalogStatus</small>
                @if (!string.IsNullOrWhiteSpace(liveSearchStatus))
                {
                    <small class="catalog-status">
                        @liveSearchStatus
                    </small>
                }
                <button class="api-search-button" @onclick="SearchJobsAsync" disabled="@(!CanSearchJobs || isBusy)">Search jobs</button>
                @if (!CanSearchJobs)
                {
                    <small class="api-key-hint">@JobSearchHint</small>
                }
                <div class="job-ledger">
                    <div>
                        <strong>Applied-job folder</strong>
                        <small>
                            @jobFolderMessage @if (lastTailoredResumeBytes is not null) {
                            <span>Latest tailored CV is ready to attach.</span>
                        }
                    </small>
                </div>
                <button type="button" @onclick="MapJobFolderAsync" disabled="@(!jobFolderSupported || isBusy)">Map local folder</button>
                <button type="button" title="Application was submitted to the employer" @onclick='() => SaveSelectedJobsAsync("Applied")' disabled="@(selectedJobFingerprints.Count == 0 || !jobFolderReady || isBusy)">Mark applied</button>
                <button type="button" title="Application lifecycle is closed, withdrawn, rejected, or otherwise finished" @onclick='() => SaveSelectedJobsAsync("Completed")' disabled="@(selectedJobFingerprints.Count == 0 || !jobFolderReady || isBusy)">Close application</button>
            </div>
            @if (jobResults.Count > 0)
            {
                <div class="result-filter-bar">
                    <strong>@FilteredJobs.Count() of @jobResults.Count jobs</strong>
                    <input @bind="resultTextFilter" @bind:event="oninput" placeholder="Filter fetched results" />
                    <button type="button" @onclick="ClearResultFilters">Clear</button>
                </div>
                <div class="faceted-results">
                    <aside class="facet-panel">
                        <h3>Filter fetched jobs <small>Local · no API credits</small></h3>
                        <FacetGroup Title="Work mode" Options="@FacetOptions(WorkMode)" Selected="@workModeFilters" Changed="@ToggleWorkMode" />
                        <FacetGroup Title="Experience" Options="@FacetOptions(ExperienceBand)" Selected="@experienceFilters" Changed="@ToggleExperience" />
                        <FacetGroup Title="Role category" Options="@FacetOptions(RoleCategory)" Selected="@roleFilters" Changed="@ToggleRole" />
                        <FacetGroup Title="Salary information" Options="@FacetOptions(SalarySignal)" Selected="@salaryFilters" Changed="@ToggleSalary" />
                        <FacetGroup Title="Education" Options="@FacetOptions(EducationSignal)" Selected="@educationFilters" Changed="@ToggleEducation" />
                        <FacetGroup Title="Source" Options="@FacetOptions(job => job.Source)" Selected="@sourceResultFilters" Changed="@ToggleResultSource" />
                        <FacetGroup Title="Top companies" Options="@FacetOptions(job => EmptyAs(job.Company, "Not specified"), 12)" Selected="@companyFilters" Changed="@ToggleCompany" />
                        <FacetGroup Title="Freshness" Options="@FacetOptions(Freshness)" Selected="@freshnessFilters" Changed="@ToggleFreshness" />
                        <FacetGroup Title="Location" Options="@FacetOptions(job => EmptyAs(job.Location, "Not specified"), 15)" Selected="@locationResultFilters" Changed="@ToggleResultLocation" />
                    </aside>
                    <div class="job-results">
                        @foreach (var job in FilteredJobs)
                        {
                            var fingerprint = JobApplicationStore.Fingerprint(job);
                            <div class="job-result-card">
                                <label class="job-select" title="Select this job for the local applied-job ledger">
                                    <input type="checkbox" checked="@selectedJobFingerprints.Contains(fingerprint)" @onchange="args => ToggleJobSelection(fingerprint, args)" />
                                    <span>Select</span>
                                </label>
                                <button type="button" class="job-result-main" @onclick="() => SelectJob(job)">
                                    <strong>@job.Title</strong>
                                    <span>@job.Company @(!string.IsNullOrWhiteSpace(job.Location) ? $"— {job.Location}" : "")</span>
                                    <small>@job.Source @(!string.IsNullOrWhiteSpace(job.PostedAt) ? $"• {job.PostedAt}" : "")</small>
                                </button>
                            </div>
                        }
                        @if (!FilteredJobs.Any())
                        {
                            <p class="empty-filter-result">No fetched jobs match these filters.</p>
                        }
                    </div>
                </div>
            }
        </details>
        <div class="job-input-section-header">
            <label class="field-label primary-action-heading" for="jobUrl">2. Import the job posting</label>
            <p class="section-prominent-subtext">Choose your preferred method to provide the job details below:</p>
        </div>

        <div class="url-row">
            <input id="jobUrl" type="url" @bind="jobUrl" @bind:event="oninput" placeholder="https://company.com/jobs/role" />
            <button @onclick="ImportJobAsync" disabled="@(string.IsNullOrWhiteSpace(jobUrl) || isBusy)">Import URL</button>
        </div>

        <div class="or-divider prominent-divider">
            <span class="prominent-or-text">OR PASTE THE DESCRIPTION</span>
        </div>

        <textarea id="jobDescription" @bind="jobDescription" @bind:event="oninput" rows="8" placeholder="Paste the job description here..."></textarea>
        <button class="score-button" @onclick="AnalyzeMatchAsync" disabled="@(!CanMatch || isBusy)">@(isBusy ? "Analyzing…" : "Calculate job match")</button>
        @if (!CanMatch && string.IsNullOrWhiteSpace(error))
        {
            <p class="action-hint">@MatchHint</p>
        }
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="alert alert-danger" role="alert">@error</p>
    }
</section>

<section class="panel result-panel" aria-live="polite">
    @if (atsResult is null && matchResult is null)
    {
        <div class="empty-result"><div class="score-ring muted">—</div><h2>@(mode == ToolMode.Ats ? "Your ATS score will appear here" : "Your job-match score will appear here")</h2><p>@(mode == ToolMode.Ats ? "Run the resume scan without supplying a job description." : "Import a posting URL or paste its description to compare relevant terms.")</p></div>
    }
    else if (atsResult is not null)
    {
        <div class="overall-result @GradeClass(atsResult.Score)"><div class="score-ring">@atsResult.Score.ToString("0")<small>%</small></div><div class="grade-badge">Grade @atsResult.Grade</div></div><h2>@ScoreHeading(atsResult.Score)</h2><p>@atsResult.Summary</p>
        <div class="quality-meter" aria-label="Resume quality: @QualityBand(atsResult.Score)">
            <i style="left:calc(@(atsResult.Score)% - 8px)"></i><div class="quality-track"></div>
            <div class="quality-labels"><span>Low</span><span>Medium</span><span>High</span><span>Excellent</span></div>
        </div>
        <div class="group-charts">
            @foreach (var group in atsResult.Checks.GroupBy(x => x.Group))
            {
                var groupScore = Math.Round(group.Sum(x => x.Score * x.Weight) / group.Sum(x => x.Weight));
                <div class="group-chart @GradeClass(groupScore)">
                    <div class="mini-donut" style="--score:@(groupScore * 3.6)deg"><span>@groupScore%</span></div>
                    <strong>@group.Key</strong><small>@GroupSummary(groupScore)</small>
                </div>
            }
            @{
                var totalSkills = atsResult.Skills.HardSkills.Count + atsResult.Skills.SoftSkills.Count; var hardShare = totalSkills == 0 ? 0 : Math.Round(atsResult.Skills.HardSkills.Count * 100d / totalSkills);
            }
            <div class="group-chart skills-chart"><div class="mini-donut skill-donut" style="--hard:@(hardShare * 3.6)deg"><span>@totalSkills</span></div><strong>Skill mix</strong><small>@atsResult.Skills.HardSkills.Count hard / @atsResult.Skills.SoftSkills.Count soft</small></div>
        </div>
            @if (showCorrectionPanel)
            {
                <ResumeCorrectionOptions Options="fixOptions"
                Title="Corrections applied to every download"
                Description="These selections are used for the fixed original, built-in templates, and uploaded templates."
                ShowRecommendationButton="true"
                EnableRecommended="EnableSafeForceCorrections">
                    <button type="button" class="generate-button" @onclick="ApplySelectedCorrectionsAndRecheckAsync"
                    disabled="@(resume is null || isBusy)">
                        Apply selected corrections &amp; recheck ATS
                    </button>
                </ResumeCorrectionOptions>


                <div class="resume-actions">
                    <div class="output-option fix-output">
                        <h3>@(resume?.FileType == "PDF" ? "Rebuild corrected DOCX" : "Fix original formatting")</h3>
                        <p>@(resume?.FileType == "PDF" ? "Convert the PDF into a corrected, editable ATS-safe Word document." : "Preserve the uploaded Word layout and apply safe text corrections.")</p>
                        @if (resume?.FileType == "PDF")
                        {
                            <p class="format-warning"><strong>Layout warning:</strong> a PDF has fixed drawing instructions, not editable Word formatting. Upload the original DOCX as the resume if the corrected download must retain the exact layout.</p>
                        }
                        <ResumeCorrectionOptions Options="fixOptions" />
                        <button class="generate-button" @onclick="FixOriginalAsync" disabled="@(resume is null || isBusy)">@(resume?.FileType == "PDF" ? "Download corrected DOCX" : "Download fixed original")</button>
                        @if (resume?.FileType == "PDF")
                        {
                            <small>This action rebuilds the content; it does not preserve the PDF's exact formatting.</small>
                        }
                    </div>
                    <div class="output-option">
                        <h3>Apply a template</h3><p>Keep the same facts and rebuild them in a deterministic ATS-safe design.</p><select @bind="selectedTemplate" aria-label="Resume template">
                            @foreach (var template in ResumeImprovementService.Templates)
                            {
                                <option value="@template.Id">@template.Name — @template.Description</option>
                            }
                        </select><button class="generate-button" @onclick="GenerateTemplateAsync" disabled="@isBusy">Generate styled DOCX</button>
                    </div>
                    <div class="output-option"><h3>Use uploaded template</h3><p>Upload a DOCX, PDF, or resume-layout image. Images are analyzed locally for palette and column structure.</p><InputFile OnChange="ReadTemplateAsync" accept=".docx,.pdf,.png,.jpg,.jpeg,.webp" class="template-file" /><small>@uploadedTemplateStatus</small><button class="generate-button" @onclick="GenerateUploadedTemplateAsync" disabled="@(uploadedTemplate is null || isBusy)">Convert with uploaded template</button></div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(downloadStatus))
    {
        <p class="generator-note" role="status">@downloadStatus</p>
    }
    @if (fixReport.Count > 0)
    {
        <div class="fix-report" aria-live="polite">
            <h3>Correction audit</h3>
            @foreach (var item in fixReport)
            {
                <div class="fix-report-item @FixStatusClass(item.Status)">
                    <strong>@item.Name</strong><span>@FixStatusLabel(item.Status)</span><p>@item.Detail</p>
                </div>
            }
        </div>
    }
    <CorrectionVerification Before="verificationBefore" After="verificationAfter" Integrity="verificationIntegrity" />
    <p class="generator-note">Generated documents never invent skills, employment, qualifications, or metrics. Review every download before applying.</p>
    <ul class="ats-checks">
        @foreach (var check in atsResult.Checks)
        {
            <li class="@MetricClass(check.Score)">
                <div class="metric-group">@check.Group</div>
                <div class="metric-heading"><strong>@check.Name</strong><span>@check.Score.ToString("0")%</span></div>
                <div class="metric-bar" role="progressbar" aria-label="@check.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@check.Score"><i style="width:@(check.Score)%"></i></div>
                <p class="metric-evidence">@check.Evidence</p>
                <p>@check.Assessment</p>
                @if (!check.IsComplete)
                {
                    <p class="metric-improvement"><strong>Improve:</strong> @check.Improvement</p>
                }
                else
                {

                    <p class="metric-complete">@check.Improvement</p>
                }
            </li>
        }
    </ul>
}
        else if (matchResult is not null)
{
    <div class="score-ring @ScoreClass(matchResult.Score)">@matchResult.Score.ToString("0")<small>%</small></div><h2>@ScoreHeading(matchResult.Score)</h2><p>@matchResult.Summary</p>
    @if (CanOpenJobUrl)
    {
        <a class="apply-job-link" href="@jobUrl" target="_blank" rel="noopener noreferrer">Open application page <span aria-hidden="true">↗</span></a>
    }
    <div class="term-columns"><div><h3 class="term-heading term-heading--strong">Strong matches</h3><TermList Terms="matchResult.MatchedTerms" EmptyText="No strong terms yet" Variant="strong" /></div><div><h3 class="term-heading term-heading--missing">Missing terms</h3><TermList Terms="FilteredMissingTerms" EmptyText="No notable gaps" Variant="missing" /></div></div>

    @if (showJobMatchImprovementsPanel)
    {
        <div class="match-generator">
            <h3>Apply job-match improvements</h3>
            <p>Selected terms are placed contextually: technologies stay in Skills, professional strengths go in the Summary, and architecture or operational requirements are attached to relevant experience evidence. Select only terms that truthfully describe your work.</p>
            <ResumeCorrectionOptions Options="fixOptions"
                                     Title="ATS objectives to apply with job tailoring"
                                     Description="The same correction engine used by ATS Compatibility is applied to this download."
                                     ShowRecommendationButton="true"
                                     EnableRecommended="EnableSafeForceCorrections" />
            <div class="match-term-options">
                @foreach (var term in FilteredMissingTerms)
                {
                    <label><input type="checkbox" checked="@selectedMatchTerms.Contains(term)" @onchange="args => ToggleMatchTerm(term, args)" />@term</label>
                }
            </div>
            @if (selectedMatchTerms.Count > 0)
            {
                <div class="term-evidence-inputs">
                    <h4>Add truthful evidence for missing terms</h4>
                    <p>Each field starts with a polished, term-specific draft. Use it as-is only when it is true, or edit it to reflect your actual work. Your confirmed statement is added to the most relevant experience paragraph.</p>
                    @foreach (var term in selectedMatchTerms.OrderBy(term => term))
                    {
                        <label for="@EvidenceInputId(term)"><strong>@term</strong><textarea id="@EvidenceInputId(term)" rows="2" value="@EvidenceFor(term)" @oninput="args => SetEvidence(term, args.Value?.ToString())"></textarea></label>
                        <label class="evidence-confirmation"><input type="checkbox" checked="@confirmedMatchTermEvidence.Contains(term)" @onchange="args => ConfirmEvidence(term, args)" /> I confirm this statement accurately describes my experience.</label>
                    }
                </div>
            }
            <button class="generate-button" @onclick="TailorForJobAsync" disabled="@(resume is null || isBusy || !resume.FileType.Equals("DOCX", StringComparison.OrdinalIgnoreCase))">Apply selected improvements &amp; download DOCX</button>
            @if (resume is not null && !resume.FileType.Equals("DOCX", StringComparison.OrdinalIgnoreCase))
            {
                <p class="metric-improvement"><strong>Original formatting protection:</strong> Upload the original DOCX to enable tailoring. PDF analysis remains available, but PDF-to-Word reconstruction cannot retain the source's editable styles and layout.</p>
            }
            <small>A universal 100% ATS guarantee is not technically possible. The audit identifies every applied and withheld instruction.</small>
            @if (!string.IsNullOrWhiteSpace(matchDownloadStatus))
            {
                <p class="generator-note">@matchDownloadStatus</p>
            }
            @if (matchFixReport.Count > 0)
            {
                <div class="fix-report">
                    <h3>Job-tailoring audit</h3>
                    @foreach (var item in matchFixReport)
                    {
                        <div class="fix-report-item @FixStatusClass(item.Status)">
                            <strong>@item.Name</strong><span>@FixStatusLabel(item.Status)</span><p>@item.Detail</p>
                        </div>
                    }
                </div>
            }
            <CorrectionVerification Before="verificationBefore" After="verificationAfter" Integrity="verificationIntegrity" />
        </div>
    }
}
</section>
</main>

<section class="trust-copy"><h2>Resume analysis that respects your privacy</h2><p>Resume files are processed locally on your device and are never uploaded. When you import a job URL, only that public URL is sent to the page reader if the website blocks direct browser access.</p></section>

@code {
    private const long MaxFileSize = 10 * 1024 * 1024;
    private ToolMode mode = ToolMode.Ats;
    private ParsedResume? resume;
    private string jobDescription = "", jobUrl = "", fileStatus = "PDF or DOCX, up to 10 MB";
    private string jobExperience = "", customKeyword = "", customLocation = "";
    private int jobAgeDays = 30;
    private IReadOnlyList<NormalizedJob> jobResults = [];
    private string catalogStatus = "Loading catalog information...";
    private string liveSearchStatus = "";
    private string localProviderStatus = "Public sources need no file. Upload job-providers.json only when selecting a credential-based source.";
    private string? localProviderConfiguration;
    private int catalogJobCount;
    private IReadOnlyList<string> catalogKeywords = [];
    private IReadOnlyList<JobRoleGroup> catalogRoleGroups = [];
    private IReadOnlyList<string> catalogLocations = [];
    private HashSet<string> selectedKeywords = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> selectedLocations = new(StringComparer.OrdinalIgnoreCase);
    private string resultTextFilter = "";
    private HashSet<string> workModeFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> experienceFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> roleFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> salaryFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> educationFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> sourceResultFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> companyFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> freshnessFilters = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> locationResultFilters = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<JobProviderState> catalogProviderStates = [];
    private HashSet<string> selectedSources = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> selectedJobFingerprints = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> appliedJobFingerprints = new(StringComparer.OrdinalIgnoreCase);
    private bool jobFolderSupported = true;
    private bool jobFolderReady;
    private string jobFolderMessage = "Choose a folder to store encrypted applied-job records.";
    private string selectedTemplate = "professional";
    private UploadedResumeTemplate? uploadedTemplate;
    private ImageTemplateAnalysis? imageTemplateAnalysis;
    private string uploadedTemplateStatus = "No template selected";
    private ProfessionalHub.ResumeTools.Models.ResumeFixOptions fixOptions = new();
    private IReadOnlyList<ResumeFixOutcome> fixReport = [];
    private IReadOnlyList<ResumeFixOutcome> matchFixReport = [];
    private AtsResult? verificationBefore;
    private AtsResult? verificationAfter;
    private ResumeIntegrityResult? verificationIntegrity;
    private HashSet<string> selectedMatchTerms = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> matchTermEvidence = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> confirmedMatchTermEvidence = new(StringComparer.OrdinalIgnoreCase);
    private string? matchDownloadStatus;
    private byte[]? lastTailoredResumeBytes;
    private string lastTailoredResumeFileName = "";
    private string? downloadStatus;
    private string? error;
    private bool isBusy;
    private string busyTitle = "Processing resume";
    private string busyDetail = "Preparing your document...";
    private AtsResult? atsResult;
    private MatchResult? matchResult;
    private bool HasResume => resume is not null && !string.IsNullOrWhiteSpace(resume.Text);
    private bool CanMatch => HasResume && !string.IsNullOrWhiteSpace(jobDescription);
    private bool CanOpenJobUrl => Uri.TryCreate(jobUrl, UriKind.Absolute, out var uri) &&
                                  uri.Scheme is "http" or "https";
    private void EnableSafeForceCorrections()
    {
        if (resume is null) return;
        var analysis = atsResult ?? Ats.Analyze(resume);
        bool Unmet(string name) => analysis.Checks.Any(check =>
            check.Name.Equals(name, StringComparison.OrdinalIgnoreCase) && check.Score < 100);
        fixOptions.ForceCompactPageLayout = fixOptions.CompactPageLayout &&
                                            (Unmet("Page count") || Unmet("Word count"));
        fixOptions.ForceBalanceBoldUsage = fixOptions.BalanceBoldUsage && Unmet("Bold usage");
        fixOptions.ForceProfessionalSummary = fixOptions.AddProfessionalSummaryHeading &&
                                              Unmet("Professional summary");
        fixOptions.ForceEvidenceBackedStrengths = fixOptions.AddEvidenceBackedStrengths &&
                                                  (Unmet("Soft skills") || Unmet("Skills efficiency ratio"));
    }
