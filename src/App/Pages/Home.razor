    private string DefaultEvidenceDraft(string term)
    {
        if (string.IsNullOrWhiteSpace(term))
            return "Applied this requirement successfully across project deliverables.";

        var cleanTerm = term.Trim();

        // 1. Try to extract dynamic context directly from the job description sentences
        if (!string.IsNullOrWhiteSpace(jobDescription))
        {
            try
            {
                var sentences = jobDescription.Split(new[] { '.', '!', '?' }, StringSplitOptions.RemoveEmptyEntries);
                var matchingSentence = sentences
                    .FirstOrDefault(s => s.Contains(cleanTerm, StringComparison.OrdinalIgnoreCase));

                if (!string.IsNullOrWhiteSpace(matchingSentence))
                {
                    var cleanedSentence = matchingSentence.Trim();
                    return ChooseContextualDraft(cleanTerm, cleanedSentence);
                }
            }
            catch
            {
                // Fall back to algorithmic variation if splitting fails
            }
        }

        // 2. Fully Automated & Varied Algorithmic Fallback
        return BuildVariedDynamicStatement(cleanTerm);
    }

    private static string ChooseContextualDraft(string term, string sentence)
    {
        int variant = Math.Abs(term.GetHashCode()) % 3;
        var lowerSentence = LowercaseFirst(sentence);

        return variant switch
        {
            0 => $"Spearheaded initiatives involving {term}, directly contributing to goals concerning {lowerSentence}.",
            1 => $"Utilized deep proficiency in {term} to execute core deliverables, ensuring alignment with requirements like {lowerSentence}.",
            _ => $"Applied hands-on expertise in {term} to optimize performance and fulfill project objectives around {lowerSentence}."
        };
    }

    private static string BuildVariedDynamicStatement(string term)
    {
        var lower = term.ToLowerInvariant();
        int seed = Math.Abs(term.GetHashCode()) % 4;

        if (lower.EndsWith("ing") || lower.Contains("management") || lower.Contains("analysis") || lower.Contains("development"))
        {
            return seed switch
            {
                0 => "Directed and executed full life-cycle workflows for " + term + ", implementing robust standards to maximize output quality.",
                1 => "Led core initiatives focused on " + term + ", driving operational efficiency and cross-functional collaboration.",
                2 => "Spearheaded complex requirements related to " + term + ", establishing best practices and measurable milestones.",
                _ => "Engineered scalable solutions integrating " + term + ", aligning technical outcomes with overarching business goals."
            };
        }

        if (lower.Length <= 6 && lower.All(char.IsUpper))
        {
            return seed switch
            {
                0 => "Architected and maintained infrastructure utilizing " + term + ", ensuring high availability, security, and scalability.",
                1 => "Integrated " + term + " into distributed production environments to streamline data pipelines and service delivery.",
                2 => "Optimized system performance and reliability through advanced configuration and deployment of " + term + ".",
                _ => "Administered core components built on " + term + ", resolving critical bottlenecks and automating deployment workflows."
            };
        }

        return seed switch
        {
            0 => "Designed, tested, and deployed solutions incorporating " + term + ", achieving seamless integration across systems.",
            1 => "Collaborated with engineering teams to apply " + term + ", successfully resolving technical challenges and meeting deadlines.",
            2 => "Delivered high-impact results using " + term + ", emphasizing performance tuning and maintainable architecture.",
            _ => "Implemented structured frameworks utilizing " + term + ", enhancing system capability and long-term maintainability."
        };
    }
