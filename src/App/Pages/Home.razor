    protected override async Task OnInitializedAsync()
    {
        JobCatalogInfo? info = null;
        JobSearchOptions options = new();
        showCorrectionPanel = Configuration.GetValue<bool>("ResumeSettings:ShowCorrectionOptionsPanel", true);
        showJobMatchImprovementsPanel = Configuration.GetValue<bool>("ResumeSettings:ShowJobMatchImprovementsPanel", true);
        try
        {
            options = await JobSearch.GetSearchOptionsAsync();
        }
        catch { /* Custom entries remain available even if the packaged option list is unavailable. */ }

        try { info = await JobSearch.GetCatalogInfoAsync(); }
        catch { /* The static catalog is optional for live provider searches. */ }

        catalogRoleGroups = options.RoleGroups.Count > 0
            ? options.RoleGroups
            : info is not null && info.Keywords.Count > 0
                ? [new JobRoleGroup { Name = "Configured roles", Roles = info.Keywords.ToList() }]
                : [];
        catalogKeywords = catalogRoleGroups.SelectMany(group => group.Roles)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        catalogLocations = options.Locations.Count > 0
            ? options.Locations
            : info?.Locations ?? [];
        catalogProviderStates = (info?.Routing ?? [])
            .GroupBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.Last()).OrderBy(x => x.Name).ToList();
        selectedSources.Clear();
        foreach (var source in DefaultPublicSources.Where(name =>
                     catalogProviderStates.Any(state =>
                         state.Name.Equals(name, StringComparison.OrdinalIgnoreCase))))
            selectedSources.Add(source);

        catalogJobCount = info?.JobCount ?? 0;
        catalogStatus = info?.GeneratedAt is not null
            ? $"{info.JobCount:N0} jobs from {info.Provider}; refreshed {info.GeneratedAt.Value.LocalDateTime:g}."
            : catalogProviderStates.Count > 0
                ? "Live job sources are ready. The optional cached catalog is not available."
                : "Job sources could not be loaded. Refresh the page or verify the deployed data files.";

        try
        {
            var folderState = await JobApplications.GetStateAsync();
            ApplyFolderState(folderState);
            if (folderState.PermissionGranted)
                appliedJobFingerprints = new(await JobApplications.LoadFingerprintsAsync(), StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            // Folder permission is independent of job-search configuration.
        }
    }
