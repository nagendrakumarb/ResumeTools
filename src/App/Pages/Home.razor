    private async Task<ParsedResume> CaptureCorrectionVerificationAsync(
        ParsedResume source,
        ResumeFixResult result,
        string outputName)
        => await CaptureCorrectionVerificationAsync(source, result.Bytes, result.Integrity, outputName);

    private async Task<ParsedResume> CaptureCorrectionVerificationAsync(
        ParsedResume source,
        CorrectedTemplateConversionResult result,
        string outputName)
        => await CaptureCorrectionVerificationAsync(source, result.Bytes, result.Integrity, outputName);

    private async Task<ParsedResume> CaptureCorrectionVerificationAsync(
        ParsedResume source,
        byte[] bytes,
        ResumeIntegrityResult? integrity,
        string outputName)
    {
        verificationBefore = Ats.Analyze(source);
        await using var outputStream = new MemoryStream(bytes);
        var generated = await Parser.ParseAsync(outputStream, outputName);
        verificationAfter = Ats.Analyze(generated);
        verificationIntegrity = integrity;
        return generated;
    }

    private static string FixStatusClass(string status) =>
        status.StartsWith("Applied—", StringComparison.Ordinal) ? "review" :
        status == "Applied" ? "applied" :
        status is "Already satisfied" or "Verified" ? "satisfied" : "manual";

    private static string FixStatusLabel(string status) =>
        status.StartsWith("Applied—", StringComparison.Ordinal) ? "Partially applied" :
        status == "Manual action required" ? "Requires manual review" : status;

