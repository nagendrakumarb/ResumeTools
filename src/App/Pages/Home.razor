    private IReadOnlyList<string> FilteredMissingTerms => matchResult?.MissingTerms?.Where(IsValidProfessionalTerm).ToList() ?? [];

    private static bool IsValidProfessionalTerm(string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return false;
        var cleanTerm = term.Trim();

        if (cleanTerm.Length < 3) return false;

        string[] noiseWords = {
        "and", "the", "for", "with", "that", "this", "from", "you", "your",
        "are", "was", "were", "will", "can", "has", "had", "our", "their",
        "they", "she", "his", "her", "but", "not", "all", "any", "one", "out",
        "who", "which", "also", "into", "more", "some", "such", "than", "then",
        "these", "thus", "well", "what", "when", "where", "while", "delivering",
        "excellent", "strong", "team", "barbados", "project", "work", "collaborating"
    };

        if (noiseWords.Contains(cleanTerm.ToLowerInvariant())) return false;

        bool hasTechnicalSymbol = cleanTerm.Any(ch => "#+.0123456789".Contains(ch));
        bool isAllUppercase = cleanTerm.Length <= 5 && cleanTerm.All(char.IsUpper);

        if (!hasTechnicalSymbol && !isAllUppercase && char.IsUpper(cleanTerm[0]) && cleanTerm.Skip(1).All(char.IsLower))
        {
            string[] allowedCapitalized = { "DotNet", "TypeScript", "JavaScript", "GitHub", "PostgreSQL", "MongoDB" };
            if (!allowedCapitalized.Contains(cleanTerm, StringComparer.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }

